QMainWindow {
    background-color: #f1f5f9;
}

QWidget {
    font-family: "Arial";
    font-size: 14px;
    color: #0f172a;
}

QLabel#title {
    font-size: 34px;
    font-weight: bold;
    color: #1e3a8a;
}

QLabel#subtitle {
    font-size: 16px;
    color: #64748b;
}

QLabel#sectionTitle {
    font-size: 24px;
    font-weight: bold;
    color: #0f172a;
}

QLabel#sectionSubtitle {
    font-size: 14px;
    color: #64748b;
}

QFrame#card {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
}

QFrame#roleCard {
    background-color: #ffffff;
    border: 1px solid #dbeafe;
    border-radius: 18px;
}

QFrame#roleCard:hover {
    border: 2px solid #3b82f6;
    background-color: #f8fbff;
}

QLabel#roleTitle {
    font-size: 21px;
    font-weight: bold;
    color: #1e3a8a;
}

QLabel#roleDescription {
    font-size: 14px;
    color: #64748b;
}

QPushButton {
    background-color: #2563eb;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #1d4ed8;
}

QPushButton:pressed {
    background-color: #1e40af;
}

QPushButton#secondaryButton {
    background-color: #e2e8f0;
    color: #334155;
}

QPushButton#secondaryButton:hover {
    background-color: #cbd5e1;
}

QPushButton#successButton {
    background-color: #16a34a;
}

QPushButton#successButton:hover {
    background-color: #15803d;
}

QPushButton#dangerButton {
    background-color: #dc2626;
}

QPushButton#dangerButton:hover {
    background-color: #b91c1c;
}

QLineEdit,
QComboBox,
QDateEdit,
QTableWidget {
    background-color: white;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 9px;
}

QLineEdit:focus,
QComboBox:focus,
QDateEdit:focus {
    border: 2px solid #3b82f6;
}

QTableWidget {
    gridline-color: #e2e8f0;
    padding: 0px;
}

QHeaderView::section {
    background-color: #1e3a8a;
    color: white;
    padding: 10px;
    border: none;
    font-weight: bold;
}

QTableWidget::item {
    padding: 8px;
}

QTableWidget::item:selected {
    background-color: #dbeafe;
    color: #1e3a8a;
}

QStatusBar {
    background-color: #e2e8f0;
    color: #475569;
}

QLineEdit,
QComboBox,
QDateTimeEdit {
    min-height: 32px;
    padding: 5px 9px;
    font-size: 13px;
}

QFormLayout {
    spacing: 14px;
}

QLabel {
    min-height: 20px;
}

QPushButton#activeButton {
    background-color: #2563eb;
    color: white;
}

QPushButton#activeButton:hover {
    background-color: #1d4ed8;
}

QPushButton#successButton {
    background-color: #16a34a;
}

QPushButton#successButton:hover {
    background-color: #15803d;
}

QLabel#errorLabel {
    color: #dc2626;
    font-size: 13px;
    font-weight: bold;
}