/* ==========================================================
   MediSync — estilo global
   Tokens {{icon:nome:#cor}} são resolvidos em gui/theme.py
   ========================================================== */

* {
    font-family: "Segoe UI", "Noto Sans", "Arial", "DejaVu Sans";
    color: #16324d;
}

QMainWindow, QWidget#receptionDashboard {
    background: #f4f8fb;
}

QToolTip {
    background: #16324d;
    color: #ffffff;
    border: none;
    padding: 5px 8px;
    border-radius: 6px;
}

/* ---------------- Menu lateral ---------------- */
QFrame#sidebar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #0b4a37, stop:1 #06382b);
    border: none;
}

QLabel#logo {
    color: #ffffff;
    font-size: 23px;
    font-weight: 800;
    background: transparent;
}

QLabel#logoSubtitle {
    color: #a9cbc0;
    font-size: 11px;
    background: transparent;
}

QFrame#sidebarDivider {
    background: rgba(255, 255, 255, 0.10);
    border: none;
}

QLabel#sidebarFooter {
    color: #c2d9d2;
    font-size: 12px;
    background: transparent;
}

QPushButton#navItem, QPushButton#navSub {
    background: transparent;
    border: none;
    border-radius: 10px;
    text-align: left;
}

QPushButton#navItem:hover, QPushButton#navSub:hover {
    background: rgba(255, 255, 255, 0.08);
}

QPushButton#navItem[active="true"], QPushButton#navSub[active="true"] {
    background: #109c62;
}

QLabel#navLabel {
    color: #c4dcd5;
    font-size: 13px;
    font-weight: 500;
    background: transparent;
}

QPushButton#navItem[group="true"] QLabel#navLabel,
QPushButton#navItem[active="true"] QLabel#navLabel,
QPushButton#navSub[active="true"] QLabel#navLabel {
    color: #ffffff;
    font-weight: 700;
}

/* ---------------- Barra superior ---------------- */
QFrame#topbar {
    background: #ffffff;
    border: none;
    border-bottom: 1px solid #e4edf0;
}

QFrame#searchBox {
    background: #f6f9fc;
    border: 1px solid #dbe7ed;
    border-radius: 12px;
}

QFrame#searchBox[focused="true"] {
    background: #ffffff;
    border: 1px solid #2aa878;
}

QFrame#searchBox QLineEdit {
    background: transparent;
    border: none;
    min-height: 0px;
    max-height: 16777215px;
    padding: 0px;
    color: #27405d;
    font-size: 13px;
}

QLabel#kbdHint {
    color: #6b8194;
    background: #eaf0f4;
    border: 1px solid #dbe5eb;
    border-radius: 6px;
    padding: 2px 7px;
    font-size: 11px;
}

QToolButton#topIconButton {
    border: none;
    background: transparent;
    border-radius: 10px;
}

QToolButton#topIconButton:hover {
    background: #f0f7f5;
}

QLabel#notifBadge {
    background: #ef4444;
    color: #ffffff;
    border-radius: 8px;
    font-size: 10px;
    font-weight: 700;
}

QFrame#topSeparator {
    background: #e5ecef;
    border: none;
}

QPushButton#userChip {
    background: transparent;
    border: none;
    border-radius: 12px;
    min-width: 200px;
    text-align: left;
}

QPushButton#userChip:hover {
    background: #f0f7f5;
}

QLabel#userName {
    color: #12304a;
    font-size: 13px;
    font-weight: 700;
    background: transparent;
}

QLabel#userRole {
    color: #6b8194;
    font-size: 11px;
    background: transparent;
}

/* usado também pelo painel do médico */
QToolButton#profileButton {
    color: #17324e;
    background: transparent;
    border: none;
    border-radius: 10px;
    padding: 5px 8px;
    min-width: 150px;
    min-height: 42px;
    font-size: 12px;
    font-weight: 700;
    text-align: left;
}

QToolButton#profileButton:hover {
    background: #f0f7f5;
}

QMenu#profileMenu {
    background: #ffffff;
    border: 1px solid #dfe9ee;
    border-radius: 12px;
    padding: 7px;
    color: #17324e;
    font-size: 13px;
}

QMenu#profileMenu::item {
    padding: 10px 14px 10px 10px;
    border-radius: 8px;
}

QMenu#profileMenu::item:selected {
    background: #e8f7f0;
    color: #0b8054;
}

QMenu#profileMenu::separator {
    height: 1px;
    background: #e8eef1;
    margin: 6px 8px;
}

/* ---------------- Páginas ---------------- */
QScrollArea#pageScroll, QWidget#pageCanvas {
    background: #f4f8fb;
    border: none;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #c9d8e0;
    border-radius: 4px;
    min-height: 36px;
}

QScrollBar::handle:vertical:hover { background: #a9bfcb; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }

QPushButton#backButton {
    background: transparent;
    color: #49667d;
    border: none;
    min-height: 24px;
    padding: 0;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#backButton:hover { color: #0c9560; }

QLabel#pageTitle {
    color: #0f2547;
    font-size: 28px;
    font-weight: 800;
}

QLabel#pageSubtitle {
    color: #67809a;
    font-size: 14px;
}

QLabel#heroIcon {
    background: #12b86e;
    border-radius: 18px;
}

QFrame#modernCard, QFrame#formCard {
    background: #ffffff;
    border: 1px solid #e3ecf0;
    border-radius: 16px;
}

QLabel#cardIcon {
    background: #e1f8ed;
    border-radius: 16px;
}

QLabel#cardTitle {
    color: #102542;
    font-size: 20px;
    font-weight: 800;
}

QLabel#cardDescription {
    color: #68809a;
    font-size: 13px;
}

QLabel#sectionIcon {
    background: #e4f8ef;
    border-radius: 9px;
}

QLabel#formSection {
    color: #12304a;
    font-size: 16px;
    font-weight: 800;
}

QFrame#formDivider {
    background: #e9f0f3;
    border: none;
}

QLabel#fieldLabel {
    color: #1d3a52;
    font-size: 13px;
    font-weight: 700;
}

/* ---------------- Campos ---------------- */
QLineEdit, QComboBox, QDateEdit, QTimeEdit {
    background: #fbfdfe;
    border: 1px solid #d6e4eb;
    border-radius: 10px;
    min-height: 42px;
    max-height: 42px;
    padding: 0 13px;
    color: #173653;
    font-size: 13px;
}

QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QTimeEdit:focus {
    border: 1px solid #24b77a;
    background: #ffffff;
}

QLineEdit[readOnly="true"] {
    background: #f1f5f8;
    color: #6e8396;
}

QDateEdit, QTimeEdit {
    padding-right: 44px;
}

QTimeEdit::up-button, QTimeEdit::down-button {
    width: 0px;
    height: 0px;
    border: none;
}

QComboBox[leftIcon="true"] {
    padding-left: 42px;
}

/* combo editável: o QLineEdit interno não pode ter moldura própria */
QComboBox QLineEdit {
    background: transparent;
    border: none;
    min-height: 0px;
    max-height: 16777215px;
    padding: 0px;
    margin: 0px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 40px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    image: url("{{icon:chevron-down:#4a6a80}}");
    width: 16px;
    height: 16px;
}

QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 44px;
    border: none;
    background: transparent;
}

QDateEdit::down-arrow {
    image: url("{{icon:calendar:#4a6a80}}");
    width: 18px;
    height: 18px;
}

QComboBox QAbstractItemView {
    background: #ffffff;
    border: 1px solid #dfe9ee;
    border-radius: 8px;
    padding: 4px;
    outline: none;
    selection-background-color: #e8f7f0;
    selection-color: #0b8054;
}

QToolButton#fieldSearchButton {
    background: #f5f9fb;
    border: 1px solid #d6e4eb;
    border-radius: 10px;
    min-width: 48px;
    min-height: 44px;
}

QToolButton#fieldSearchButton:hover {
    background: #e8f6f0;
    border-color: #9dd9c0;
}

/* ---------------- Botões ---------------- */
QPushButton#successButton, QPushButton#blueButton {
    color: #ffffff;
    border: none;
    border-radius: 10px;
    min-height: 44px;
    padding: 0 20px;
    font-size: 13px;
    font-weight: 800;
}

QPushButton#successButton { background: #0f9f64; }
QPushButton#successButton:hover { background: #0b8853; }
QPushButton#blueButton { background: #1688e8; }
QPushButton#blueButton:hover { background: #0b72c8; }

QPushButton#secondaryButton {
    color: #35516b;
    background: #ffffff;
    border: 1px solid #d6e2e9;
    border-radius: 10px;
    min-height: 44px;
    padding: 0 20px;
    font-size: 13px;
    font-weight: 700;
}

QPushButton#secondaryButton:hover { background: #f1f6f8; }

/* ---------------- Cartões de estatística ---------------- */
QFrame#statCard {
    background: #ffffff;
    border: 1px solid #e0e9ee;
    border-radius: 14px;
}

QLabel#statIcon {
    background: #e5f8ef;
    border-radius: 12px;
}

QLabel#statValue {
    color: #112746;
    font-size: 22px;
    font-weight: 800;
}

QLabel#statLabel {
    color: #71869b;
    font-size: 12px;
}

/* ---------------- Tabelas ---------------- */
QTableWidget {
    background: #ffffff;
    border: 1px solid #e2ebef;
    border-radius: 10px;
    gridline-color: #edf2f5;
    alternate-background-color: #f8fbfc;
    selection-background-color: #dff5eb;
    selection-color: #123d31;
    padding: 2px;
}

QHeaderView::section {
    background: #f2f7f8;
    color: #486176;
    padding: 11px 9px;
    border: none;
    border-bottom: 1px solid #dfe9ed;
    font-size: 12px;
    font-weight: 800;
}

QTableWidget::item {
    padding: 9px;
    border-bottom: 1px solid #eef3f5;
}
