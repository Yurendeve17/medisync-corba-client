
/* =========================
   MediSync - Modern UI
   ========================= */
* {
    font-family: "Segoe UI", "Arial";
    color: #12233f;
}

QMainWindow, QWidget#receptionDashboard {
    background: #f4f8fb;
}

QFrame#sidebar {
    background: #062d2b;
    border: none;
}

QLabel#logo {
    color: #ffffff;
    font-size: 25px;
    font-weight: 800;
    padding-left: 5px;
}

QLabel#logoSubtitle {
    color: #a9cbc7;
    font-size: 11px;
    padding-left: 40px;
}

QLabel#sidebarPulse {
    color: #23d889;
    font-size: 31px;
    padding-left: 8px;
}

QLabel#sidebarFooter {
    color: #c2d9d6;
    font-size: 12px;
    line-height: 1.3;
    padding: 0 8px 3px 8px;
}

QPushButton#navButton,
QPushButton#navSection {
    text-align: left;
    border: none;
    border-radius: 10px;
    background: transparent;
    color: #c8dcda;
    min-height: 42px;
    padding: 0 13px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#navButton:hover {
    background: #0b4641;
    color: white;
}

QPushButton#navButton[active="true"] {
    background: #11a96b;
    color: white;
    font-weight: 700;
}

QPushButton#navSection {
    color: white;
    font-weight: 700;
    margin-top: 2px;
}

QFrame#topbar {
    background: white;
    border-bottom: 1px solid #e4edf0;
}

QLineEdit#globalSearch {
    min-height: 40px;
    border: 1px solid #dbe7ed;
    border-radius: 12px;
    background: #f6f9fc;
    padding: 0 15px;
    color: #27405d;
    font-size: 13px;
}

QLineEdit#globalSearch:focus {
    border: 1px solid #2aa878;
    background: white;
}

QLabel#topIcon {
    color: #49657d;
    font-size: 19px;
    padding: 7px 9px;
}

QFrame#topSeparator {
    color: #e5ecef;
    margin: 5px 10px;
}

QLabel#userProfile {
    color: #17324e;
    font-size: 12px;
    font-weight: 700;
    padding: 0 10px;
}

QPushButton#backButton {
    background: #f0f7f5;
    color: #17654c;
    border: 1px solid #d8ebe5;
    border-radius: 10px;
    min-height: 38px;
    padding: 0 16px;
    font-weight: 700;
}

QPushButton#backButton:hover {
    background: #e2f3ec;
}

QFrame#pageHero {
    background: transparent;
    border: none;
}

QLabel#heroIcon {
    background: #14b86e;
    color: white;
    border-radius: 17px;
    font-size: 27px;
    font-weight: 700;
}

QLabel#pageTitle {
    color: #112447;
    font-size: 28px;
    font-weight: 800;
}

QLabel#pageSubtitle {
    color: #67809a;
    font-size: 14px;
}

QFrame#modernCard {
    background: white;
    border: 1px solid #e0e9ee;
    border-radius: 16px;
}

QFrame#modernCard:hover {
    border: 1px solid #cde2dc;
}

QLabel#cardIcon {
    background: #e1f8ed;
    color: #07945b;
    border-radius: 16px;
    font-size: 24px;
    font-weight: 700;
}

QLabel#cardTitle {
    color: #102542;
    font-size: 20px;
    font-weight: 800;
}

QLabel#cardDescription {
    color: #68809a;
    font-size: 13px;
}

QLabel#sectionIcon {
    color: #0ca466;
    background: #e4f8ef;
    border-radius: 8px;
    padding: 5px;
    font-size: 15px;
}

QLabel#formSection {
    color: #163451;
    font-size: 15px;
    font-weight: 800;
}

QLabel#fieldLabel {
    color: #203a56;
    font-size: 12px;
    font-weight: 700;
}

QLabel#helperText {
    color: #7a8fa3;
    font-size: 12px;
    background: #f7fafc;
    border-radius: 8px;
    padding: 10px;
}

QLineEdit, QComboBox, QDateTimeEdit, QDateEdit, QTimeEdit {
    background: #fbfdfe;
    border: 1px solid #d6e4eb;
    border-radius: 10px;
    min-height: 42px;
    padding: 0 12px;
    color: #173653;
    font-size: 13px;
}

QLineEdit:focus, QComboBox:focus, QDateTimeEdit:focus, QDateEdit:focus, QTimeEdit:focus {
    border: 2px solid #24b77a;
    background: white;
}

QComboBox::drop-down {
    border: none;
    width: 32px;
}

QPushButton#successButton,
QPushButton#blueButton {
    color: white;
    border: none;
    border-radius: 10px;
    min-height: 42px;
    padding: 0 18px;
    font-size: 13px;
    font-weight: 800;
}

QPushButton#successButton {
    background: #0daf69;
}

QPushButton#successButton:hover {
    background: #07945a;
}

QPushButton#blueButton {
    background: #1688e8;
}

QPushButton#blueButton:hover {
    background: #0b72c8;
}

QPushButton#secondaryButton {
    color: #35516b;
    background: #f0f5f8;
    border: 1px solid #dce6eb;
    border-radius: 10px;
    min-height: 42px;
    padding: 0 18px;
    font-weight: 700;
}

QPushButton#secondaryButton:hover {
    background: #e5edf2;
}

QFrame#statCard {
    background: white;
    border: 1px solid #e0e9ee;
    border-radius: 14px;
    min-height: 82px;
}

QLabel#statIcon {
    color: #0aa365;
    background: #e5f8ef;
    border-radius: 12px;
    padding: 10px;
    font-size: 20px;
}

QLabel#statValue {
    color: #112746;
    font-size: 22px;
    font-weight: 800;
}

QLabel#statLabel {
    color: #71869b;
    font-size: 12px;
}

QTableWidget {
    background: white;
    border: 1px solid #e2ebef;
    border-radius: 10px;
    gridline-color: #edf2f5;
    alternate-background-color: #f8fbfc;
    selection-background-color: #dff5eb;
    selection-color: #123d31;
    padding: 2px;
}

QHeaderView::section {
    background: #f2f7f8;
    color: #486176;
    padding: 11px 9px;
    border: none;
    border-bottom: 1px solid #dfe9ed;
    font-size: 12px;
    font-weight: 800;
}

QTableWidget::item {
    padding: 9px;
    border-bottom: 1px solid #eef3f5;
}

QScrollBar:vertical {
    background: #edf3f5;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #bfd0d5;
    border-radius: 5px;
    min-height: 35px;
}

QLabel#title {
    color: #102542;
    font-size: 34px;
    font-weight: 800;
}

QLabel#subtitle {
    color: #6b8196;
    font-size: 15px;
}

QLabel#sectionTitle {
    color: #102542;
    font-size: 22px;
    font-weight: 800;
}

QLabel#sectionSubtitle {
    color: #6b8196;
    font-size: 13px;
}

QFrame#card {
    background: white;
    border: 1px solid #e1e9ee;
    border-radius: 16px;
}

QFrame#roleCard {
    background: white;
    border: 1px solid #dce9e6;
    border-radius: 16px;
}

QPushButton {
    background: #0daf69;
    color: white;
    border: none;
    border-radius: 9px;
    min-height: 38px;
    padding: 0 16px;
    font-weight: 700;
}

QPushButton:hover {
    background: #07945a;
}

QLabel#errorLabel {
    color: #dc2626;
    font-size: 13px;
    font-weight: bold;
}

QStatusBar {
    background: #eef4f5;
    color: #526b80;
}


/* Campos específicos do formulário moderno */
QLineEdit#appointmentPatientName {
    background: #f1f5f7;
    color: #6f8496;
}

QToolButton#fieldSearchButton {
    background: transparent;
    color: #45657b;
    border: 1px solid #d6e4eb;
    border-radius: 10px;
    min-width: 42px;
    min-height: 42px;
    font-size: 22px;
    font-weight: 500;
}

QToolButton#fieldSearchButton:hover {
    background: #eef8f4;
    color: #0daf69;
    border-color: #bfe3d4;
}

QDateEdit, QTimeEdit {
    padding-right: 28px;
}

QDateEdit::drop-down,
QTimeEdit::drop-down {
    width: 28px;
    border: none;
}


/* Páginas de formulário - reprodução visual do layout de referência */
QPushButton#backLink {
    background: transparent;
    color: #526d86;
    border: none;
    min-height: 24px;
    padding: 0;
    font-size: 12px;
    font-weight: 600;
}
QPushButton#backLink:hover {
    color: #0b9d63;
}
QFrame#targetHero {
    background: transparent;
    border: none;
    min-height: 78px;
}
QLabel#targetHeroIcon {
    background: #18b86e;
    color: white;
    border-radius: 18px;
    font-size: 31px;
    font-weight: 700;
}
QLabel#targetPageTitle {
    color: #10254a;
    font-size: 28px;
    font-weight: 800;
}
QLabel#targetPageSubtitle {
    color: #6a8198;
    font-size: 14px;
    line-height: 1.25;
}

/* Ícones SVG do layout de referência */
QLabel#logoText {
    color: #ffffff;
    font-size: 25px;
    font-weight: 800;
}

QPushButton#navButton, QPushButton#navSection {
    qproperty-iconSize: 18px 18px;
    padding-left: 10px;
    spacing: 10px;
}

QLabel#topCount {
    color: #49657d;
    font-size: 12px;
    font-weight: 700;
    margin-left: -7px;
    margin-right: 8px;
}

QPushButton#successButton, QPushButton#secondaryButton {
    qproperty-iconSize: 18px 18px;
}
